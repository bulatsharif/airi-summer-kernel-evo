{
  "$schema": "https://opencode.ai/config.json",
  "model": "qwen-server/qwen3.6-35b-a3b",
  "small_model": "qwen-server/qwen3.6-35b-a3b",
  "enabled_providers": [
    "qwen-server",
    "gemma-server",
    "deepseek"
  ],
  "instructions": [
    "AGENTS.md",
    ".opencode/AUTHORING_SCOPE.md"
  ],
  "provider": {
    "qwen-server": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qwen3.6 Server",
      "options": {
        "baseURL": "{env:QWEN_BASE_URL}",
        "apiKey": "{env:QWEN_API_KEY}",
        "timeout": 900000
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B A3B Q8_0",
          "limit": {
            "context": 50000,
            "output": 8192
          }
        }
      }
    },
    "gemma-server": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Gemma 4 31B Server",
      "options": {
        "baseURL": "{env:GEMMA_BASE_URL}",
        "apiKey": "{env:GEMMA_API_KEY}",
        "timeout": 900000
      },
      "models": {
        "google/gemma-4-31B-it": {
          "name": "Gemma 4 31B IT",
          "limit": {
            "context": 50000,
            "output": 8192
          }
        }
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "{env:DEEPSEEK_BASE_URL}",
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "timeout": 900000
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 128000,
            "output": 32768
          },
          "options": {
            "reasoning_effort": "low"
          }
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "glob": "deny",
    "grep": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "tasks/**": "deny",
      "src/kernel_evo/**": "deny",
      "tests/**": "deny",
      "experiments/**": "deny",
      "**/b300/**": "deny",
      "results/**/b300/**": "deny",
      "**/agent/**": "deny"
    },
    "edit": {
      "*": "deny",
      "**/kernel_evo/run/iter_*/island_*/candidate/*.py": "allow"
    },
    "bash": {
      "*": "deny",
      "kernel-evo run *": "allow",
      "kernel-evo iter *": "allow",
      "kernel-evo island *": "allow",
      "kernel-evo cute task-check *": "allow",
      "kernel-evo cute task-list": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "**/__pycache__/**",
      ".kernelevo/**",
      "experiments/**"
    ]
  }
}
