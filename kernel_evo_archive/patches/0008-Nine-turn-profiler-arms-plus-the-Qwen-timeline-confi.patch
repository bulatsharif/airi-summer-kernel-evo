From e8bffa54927fa54f9769e1cd81e285b312d7949f Mon Sep 17 00:00:00 2001
From: bulatsaripov <b.sharipov@innopolis.university>
Date: Sun, 2 Aug 2026 09:58:11 +0300
Subject: [PATCH 8/8] Nine-turn profiler arms, plus the Qwen timeline
 configuration

The profiler cannot act before the first PASS, because PARENT_PROFILE.md
is built from the parent's profile and a failed turn has none. At six
turns the GPT-2 control did not pass until turn 3, leaving three
profile-guided turns and one of those spent on a rewrite that broke a
working kernel; the Qwen arm never passed at all, so the profiler was
never exercised on it. Nine turns buys the signal room to act.

Comments on the timeline arms rewritten: since d0e445d the summary leads
with one representative iteration rather than the whole capture, whose
idle figure covers input generation and the reference and read 99.4% for
a block that is 0.4% idle.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 .../cute_ablation/prof-gpt2-timeline.yaml     | 12 ++--
 experiments/cute_ablation/prof-gpt2.yaml      |  2 +-
 .../cute_ablation/prof-qwen-timeline.yaml     | 60 +++++++++++++++++++
 3 files changed, 67 insertions(+), 7 deletions(-)
 create mode 100644 experiments/cute_ablation/prof-qwen-timeline.yaml

diff --git a/experiments/cute_ablation/prof-gpt2-timeline.yaml b/experiments/cute_ablation/prof-gpt2-timeline.yaml
index 267ded6..405970e 100644
--- a/experiments/cute_ablation/prof-gpt2-timeline.yaml
+++ b/experiments/cute_ablation/prof-gpt2-timeline.yaml
@@ -9,7 +9,7 @@ task: model_gpt2_small_transformer_block_fp8
 tiers: [errors]
 agent:
   replications: 1
-  steps: 6
+  steps: 9
   islands: 1
   # One arm per process; isolation is per-arm git worktrees.
   concurrency: 1
@@ -46,11 +46,11 @@ evaluator:
 documentation:
   delivery: prompt
 
-# E4-style profiler feedback, timeline regime: same breakdown plus the full
-# Chrome trace, which retains every GPU activity *and every idle gap* rather
-# than aggregating by kernel name. A fused layer launches 7 kernels back to
-# back, so launch gaps and serialization are visible here and invisible in the
-# aggregated view.
+# E4-style profiler feedback, timeline regime. Since d0e445d the summary leads
+# with one representative iteration -- every launch's start, end, duration and
+# the idle gap in front of it -- so a launch-bound block reads as gaps rather
+# than disappearing into a per-kernel total. The whole-capture idle figure is
+# still printed but is now labelled as covering setup and the reference too.
 profiling:
   enabled: true
   timeline: true
diff --git a/experiments/cute_ablation/prof-gpt2.yaml b/experiments/cute_ablation/prof-gpt2.yaml
index bc71eb5..32929fd 100644
--- a/experiments/cute_ablation/prof-gpt2.yaml
+++ b/experiments/cute_ablation/prof-gpt2.yaml
@@ -9,7 +9,7 @@ task: model_gpt2_small_transformer_block_fp8
 tiers: [errors]
 agent:
   replications: 1
-  steps: 6
+  steps: 9
   islands: 1
   # One arm per process; isolation is per-arm git worktrees.
   concurrency: 1
diff --git a/experiments/cute_ablation/prof-qwen-timeline.yaml b/experiments/cute_ablation/prof-qwen-timeline.yaml
new file mode 100644
index 0000000..92897dd
--- /dev/null
+++ b/experiments/cute_ablation/prof-qwen-timeline.yaml
@@ -0,0 +1,60 @@
+schema_version: 1
+order_seed: 20260801
+model: deepseek/deepseek-v4-flash
+task: model_qwen35_4b_full_attention_block_fp8
+# Best configuration measured in E1-E4 across five tasks: `errors` tier scored
+# 28/30 turns, tied best on correctness and cheapest in tokens. Knobs off --
+# E3 (critic) replicated as a negative on every task, E4 (profiler) was null,
+# and E2 (prompt delivery) was mixed and timeout-confounded.
+tiers: [errors]
+agent:
+  replications: 1
+  steps: 9
+  islands: 1
+  # One arm per process; isolation is per-arm git worktrees.
+  concurrency: 1
+  # Raised from 8192. DeepSeek's reasoning is not suppressible through any
+  # opencode config path, so it is bounded by a local proxy injecting
+  # reasoning_effort=low. Headroom still matters: unbounded reasoning
+  # consumed 8,192/8,192 and 32,767/32,768 with zero visible output.
+  max_output_tokens: 24576
+  max_repairs_per_island: 0
+  b300_seed: starter
+  # Layer tasks need room to write. At 900s the agent spent the whole
+  # session reading the 27-file bundle (52 reads, 40 steps) and never
+  # wrote a kernel; the barrier then graded the untouched skeleton.
+  session_timeout_seconds: 2400
+evaluator:
+  seed: 0
+  warmup: 5
+  repeats: 50
+  timeout_seconds: 900
+
+# Real-world layer task: full Qwen3.5-4B attention block (RMSNorm, gated QKV with RoPE, attention,
+# residual, RMSNorm, SwiGLU MLP). Reference 49.8871 ms.
+# Three independent replications are run as separate results roots so each gets
+# its own worktree; speedup was shown not to replicate at one replication, so
+# the ladder is reported over replications rather than from a single arm.
+
+# `prompt` rather than `files`: under files delivery the author opens the
+# bundle one call at a time and every tool result replays into later steps,
+# which consumed the entire session on these larger tasks. Delivering the
+# bundle once removes the read loop. E2 scored 6/6 on level1_02, level2_12
+# and level2_14, so this is not a weak tier -- it was only timeout-confounded
+# on level2_63.
+documentation:
+  delivery: prompt
+
+# E4-style profiler feedback, timeline regime. Since d0e445d the summary leads
+# with one representative iteration -- every launch's start, end, duration and
+# the idle gap in front of it -- so a launch-bound block reads as gaps rather
+# than disappearing into a per-kernel total. The whole-capture idle figure is
+# still printed but is now labelled as covering setup and the reference too;
+# before that fix it announced 99.4% idle for a block that is 0.4% idle.
+#
+# This block launches far more kernels than the GPT-2 one (RMSNorm, gated QKV
+# with partial RoPE, GQA attention, SwiGLU), so gaps are where its overhead
+# most plausibly hides.
+profiling:
+  enabled: true
+  timeline: true
