From 2a105c600beb49ecfdc6b86f7622fbb7802c6175 Mon Sep 17 00:00:00 2001
From: bulatsaripov <b.sharipov@innopolis.university>
Date: Sun, 2 Aug 2026 00:51:14 +0300
Subject: [PATCH 4/8] Add long Qwen GEMM ablation config

---
 experiments/cute_ablation/e1-l2-63-long.yaml | 48 ++++++++++++++++++++
 1 file changed, 48 insertions(+)
 create mode 100644 experiments/cute_ablation/e1-l2-63-long.yaml

diff --git a/experiments/cute_ablation/e1-l2-63-long.yaml b/experiments/cute_ablation/e1-l2-63-long.yaml
new file mode 100644
index 0000000..bf0cd6c
--- /dev/null
+++ b/experiments/cute_ablation/e1-l2-63-long.yaml
@@ -0,0 +1,48 @@
+schema_version: 1
+order_seed: 20260731
+model: qwen-server/qwen3.6-35b-a3b
+task: level2_63_gemm_relu_divide_fp8
+tiers: [bare, docs, examples, errors]
+agent:
+  replications: 1
+  # Attempts the agent gets to reach a working kernel. Each attempt is one
+  # OpenCode session that sees its own previous candidate and the B300
+  # diagnostic, never a reference implementation.
+  steps: 12
+  islands: 1
+  concurrency: 4
+  max_output_tokens: 8192
+  max_repairs_per_island: 0
+  # The agent starts from the public skeleton, never from a working kernel.
+  # The verified baseline is timed separately as the speedup denominator and
+  # is never shown to the model.
+  b300_seed: starter
+  session_timeout_seconds: 900
+evaluator:
+  seed: 0
+  warmup: 5
+  repeats: 50
+  timeout_seconds: 900
+# The three knobs below are off in the frozen protocol; see README.md. Vary one
+# at a time from the best tier rather than running the full cross.
+#
+# How the tier reaches the author: `files` materializes it and the agent opens
+# what it wants; `prompt` hands it the whole bundle before it acts.
+# documentation:
+#   delivery: prompt
+#
+# Feedback between turns: the previous candidate's B300 kernel breakdown as
+# PARENT_PROFILE.md, and one read-only LLM critique leading its feedback.
+# profiling:
+#   enabled: true
+# feedback:
+#   critic: true
+
+# Simplest epilogue among the tasks with real headroom: relu then divide, no
+# reduction, one required call. Reference run shows 2.552x available.
+documentation:
+  delivery: prompt
+
+# Longer arm: does depth advance with more attempts, or does the model keep
+# sampling new wrong symbols? Six turns showed no progression; eval budget was
+# binding at 4/4 every turn, so it is raised alongside.
-- 
